# ============================================
#  Study Wisely — Frontend Environment Template
#  Copy to .env for local development.
#  Vite inlines these at BUILD time — public only, no secrets.
# ============================================

# Backend API base URL, including the /api suffix. No trailing slash.
VITE_API_URL=http://localhost:5002/api

# Razorpay publishable Key ID (rzp_test_... or rzp_live_...).
VITE_RAZORPAY_KEY_ID=rzp_test_SbjooFQK8nvU6V


# ---------- Firebase (Project settings > Your apps > Web app) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
