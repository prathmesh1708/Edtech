# ============================================
#  Study Wisely — Frontend (PRODUCTION)
#  Vite auto-loads this during `npm run build`
#  and it OVERRIDES .env. Values are inlined into
#  the public bundle — no secrets here, ever.
#
#  Safe to commit: contains only public values.
# ============================================

# Backend API base URL on Render, including /api. No trailing slash.
# ⚠️ VERIFY this matches your actual Render service name before deploying.
VITE_API_URL=https://edtech-backend.onrender.com/api

# Razorpay publishable Key ID. Swap to your rzp_live_... key
# once Razorpay KYC is approved and you want to take real payments.
VITE_RAZORPAY_KEY_ID=rzp_test_SbjooFQK8nvU6V
