# ============================================
#  Study Wisely — Backend Environment Template
#  Copy to .env and fill in real values.
#  This file is committed — keep it free of secrets.
# ============================================

# Server port number.
PORT=5002

# Environment mode: development | production
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Allowed browser origin(s) for CORS. Comma-separated.
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Secondary/canonical origin
CLIENT_URL=http://localhost:5173

