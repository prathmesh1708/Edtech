# ============================================
#  Study Wisely — Backend Environment Template
#  Copy to .env and fill in real values.
#  This file is committed — keep it free of secrets.
# ============================================

# Server port number. PaaS hosts usually override this.
PORT=5001

# Environment mode: development | production
# "production" hides error stack traces in API responses.
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed browser origin(s) for CORS. Comma-separated, no trailing slash.
FRONTEND_URL=http://localhost:5173

# Secondary/canonical origin, also appended to the CORS allowlist.
CLIENT_URL=
