# --- DIKSHA integration ---
# Base URL of the DIKSHA (Sunbird) public API. Leave empty to disable DIKSHA
# routes (they then return 503); the rest of the app still boots.
DIKSHA_API_BASE_URL=https://diksha.gov.in
# Only if NCERT/DIKSHA issue a key (not required for the endpoints used today).
# Server-side only. Never put it in VITE_* vars.
DIKSHA_API_KEY=
DIKSHA_TIMEOUT_MS=10000
DIKSHA_CACHE_TTL_SECONDS=600
