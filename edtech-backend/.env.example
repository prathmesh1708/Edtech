# ============================================
#  Study Wisely — Backend Environment Template
#  Copy to .env and fill in real values.
#  This file is committed — keep it free of secrets.
# ============================================

# Server port number.
PORT=5002

# Environment mode: development | production
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Allowed browser origin(s) for CORS. Comma-separated.
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Only these origins (plus FRONTEND_URL / CLIENT_URL and the built-in studywisely.in list)
# may call the API from a browser.
# Secondary/canonical origin
CLIENT_URL=http://localhost:5173

# ---------- Firebase Admin SDK (Project settings > Service accounts > Generate new private key) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the JSON's private_key on one line, in double quotes, keeping its \n escapes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- DIKSHA integration ---
# Base URL of the DIKSHA (Sunbird) public API. Leave empty to disable DIKSHA
# routes (they then return 503); the rest of the app still boots.
DIKSHA_API_BASE_URL=https://diksha.gov.in
# Only if NCERT/DIKSHA issue a key (not required for the endpoints used today).
# Server-side only. Never put it in VITE_* vars.
DIKSHA_API_KEY=
DIKSHA_TIMEOUT_MS=10000
DIKSHA_CACHE_TTL_SECONDS=600

# --- AI Learning Assistant (Google Gemini) ---
# Key from https://aistudio.google.com/apikey . Server-side only. Never put it in VITE_* vars.
# Leave empty to disable the AI tutor (its routes then return 503; the rest of the app boots).
# READ AI_ASSISTANT.md "Before launch" first: the Gemini API terms restrict apps used by under-18s.
GEMINI_API_KEY=
# Free tier: each model has its own daily request quota (gemini-3.8-flash: only 20/day per project).
GEMINI_MODEL=gemini-3.5-flash
# Tried automatically when GEMINI_MODEL is out of quota (429) or overloaded (500/503). Empty = no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_QUIZ_TIMEOUT_MS=90000
# Chat: stop waiting if Gemini has not started answering within this time (overload).
GEMINI_FIRST_BYTE_TIMEOUT_MS=25000
GEMINI_MAX_OUTPUT_TOKENS=4096
# Optional, Gemini 3.x only: low = faster chat answers, high = more reasoning. Empty = model default.
GEMINI_THINKING_LEVEL=low
# Per-student limits. The free tier quota is shared by the whole project.
AI_RATE_LIMIT_PER_MINUTE=6
# 0 = unlimited (only sensible on a paid tier)
AI_DAILY_LIMIT_PER_USER=50

# LOCAL DEVELOPMENT ONLY: every registered mobile number accepts OTP 1234 (no SMS is sent).
# Anyone who knows a phone number could log in as that user — NEVER set this on a server.
# ENABLE_DEV_OTP=true

# Set to 1 when running behind nginx / a load balancer so rate limits see real client IPs.
# Leave unset if Node is exposed directly (otherwise IPs can be spoofed).
# TRUST_PROXY=1
